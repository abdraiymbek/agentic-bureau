{
  "name": "omenflow",
  "version": "0.1.0",
  "private": true,
  "description": "Omen Flow — local desktop engineering workspace for bring-your-own agent CLIs",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:bridge": "cargo build --release --locked --manifest-path native/omenflow-bridge/Cargo.toml",
    "dev": "pnpm --filter @omenflow/desktop start",
    "typecheck": "pnpm -r run typecheck && tsc -p evals/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:electron": "node scripts/rebuild-natives.mjs electron",
    "rebuild:node": "node scripts/rebuild-natives.mjs node",
    "package": "pnpm --filter @omenflow/desktop package",
    "make": "pnpm --filter @omenflow/desktop make",
    "release:macos": "node scripts/release-macos.mjs",
    "smoke:bridge": "vitest run packages/agent-host/src/bridge packages/mcp-server/src/mcp.test.ts",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "fixture:rover": "tsx fixtures/build.ts rover",
    "fixture:drone": "tsx fixtures/build.ts drone",
    "design:preview": "tsx scripts/design-preview.ts",
    "eval:cad": "tsx evals/cad/run.ts",
    "eval:workflows": "tsx evals/workflows/run.ts"
  },
  "devDependencies": {
    "@omenflow/agent-host": "workspace:^",
    "@omenflow/contracts": "workspace:^",
    "@omenflow/core": "workspace:^",
    "@omenflow/engineering": "workspace:^",
    "@omenflow/mcp-server": "workspace:^",
    "@omenflow/storage": "workspace:^",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "lodash": "4.18.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
