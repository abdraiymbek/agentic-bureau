{
  "name": "omenflow",
  "version": "1.0.0",
  "private": true,
  "description": "Omen Flow — local desktop engineering workspace for bring-your-own agent CLIs",
  "license": "Apache-2.0",
  "homepage": "https://github.com/abdraiymbek/omen-flow",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdraiymbek/omen-flow.git"
  },
  "bugs": "https://github.com/abdraiymbek/omen-flow/issues",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:bridge": "cargo build --release --locked --manifest-path native/omenflow-bridge/Cargo.toml",
    "build:rust": "node scripts/rust-app.mjs build",
    "dev": "node scripts/rust-app.mjs dev",
    "typecheck": "pnpm -r run typecheck && tsc -p evals/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "tsc -p tests/conformance/tsconfig.json && vitest run --config tests/conformance/vitest.config.ts",
    "rebuild:node": "node scripts/rebuild-natives.mjs",
    "package": "pnpm build:rust",
    "make": "pnpm build:rust",
    "release:macos": "node scripts/release-macos.mjs",
    "smoke:bridge": "vitest run packages/agent-host/src/bridge packages/mcp-server/src/mcp.test.ts",
    "smoke:packaged": "node scripts/rust-packaged-smoke.mjs",
    "smoke:headless": "node scripts/rust-packaged-smoke.mjs --headless",
    "contracts:export": "tsx scripts/export-rust-contracts.ts",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "contracts:check": "tsx scripts/export-rust-contracts.ts --check",
    "fixture:rover": "tsx fixtures/build.ts rover",
    "fixture:drone": "tsx fixtures/build.ts drone",
    "design:preview": "tsx scripts/design-preview.ts",
    "eval:agent": "tsx evals/agent/run.ts",
    "eval:cad": "tsx evals/cad/run.ts",
    "eval:workflows": "tsx evals/workflows/run.ts"
  },
  "devDependencies": {
    "@omenflow/agent-host": "workspace:^",
    "@omenflow/contracts": "workspace:^",
    "@omenflow/core": "workspace:^",
    "@omenflow/engineering": "workspace:^",
    "@omenflow/mcp-server": "workspace:^",
    "@omenflow/storage": "workspace:^",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
