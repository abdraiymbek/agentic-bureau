{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@bureau/contracts": ["./packages/contracts/src/index.ts"],
      "@bureau/storage": ["./packages/storage/src/index.ts"],
      "@bureau/core": ["./packages/core/src/index.ts"],
      "@bureau/agent-host": ["./packages/agent-host/src/index.ts"],
      "@bureau/mcp-server": ["./packages/mcp-server/src/index.ts"],
      "@bureau/engineering": ["./packages/engineering/src/index.ts"],
      "@bureau/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
