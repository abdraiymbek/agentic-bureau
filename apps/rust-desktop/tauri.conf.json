{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omen Flow",
  "version": "0.1.0",
  "identifier": "com.electron.omen-flow",
  "build": {
    "beforeDevCommand": "pnpm --filter @omenflow/desktop dev:rust-ui",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../desktop/rust-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omen Flow",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": { "capabilities": ["main"] }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../native/omenflow-bridge/target/release/omenflow": "omenflow"
    }
  }
}
