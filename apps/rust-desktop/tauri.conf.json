{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omen Flow",
  "version": "1.0.3",
  "identifier": "app.omenflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @omenflow/desktop dev:rust-ui",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../desktop/rust-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Omen Flow",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 17
        },
        "backgroundColor": "#0b0c0e"
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../native/omenflow-bridge/target/release/omenflow": "omenflow",
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "devel",
        "depends": ["libc6 (>= 2.35)", "libwebkit2gtk-4.1-0 (>= 2.41.90)", "libdbus-1-3"],
        "files": {
          "/usr/share/doc/omen-flow/copyright": "../../LICENSE",
          "/usr/share/doc/omen-flow/NOTICE": "../../NOTICE",
          "/usr/share/doc/omen-flow/THIRD_PARTY_NOTICES.md": "../../THIRD_PARTY_NOTICES.md"
        }
      },
      "rpm": {
        "depends": ["libc.so.6(GLIBC_2.35)(64bit)", "libdbus-1.so.3()(64bit)"],
        "files": {
          "/usr/share/licenses/omen-flow/LICENSE": "../../LICENSE",
          "/usr/share/licenses/omen-flow/NOTICE": "../../NOTICE",
          "/usr/share/licenses/omen-flow/THIRD_PARTY_NOTICES.md": "../../THIRD_PARTY_NOTICES.md"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/doc/omen-flow/LICENSE": "../../LICENSE",
          "/usr/share/doc/omen-flow/NOTICE": "../../NOTICE",
          "/usr/share/doc/omen-flow/THIRD_PARTY_NOTICES.md": "../../THIRD_PARTY_NOTICES.md"
        }
      }
    }
  }
}
