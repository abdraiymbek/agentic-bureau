{
  "name": "@stark/desktop",
  "version": "0.1.0",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "node scripts/vendor-natives.mjs && concurrently -k \"vite build --watch -c vite.utility.config.ts\" \"electron-forge start\"",
    "build:utility": "vite build -c vite.utility.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "pnpm run build:utility && electron-forge package",
    "make": "pnpm run build:utility && electron-forge make"
  },
  "dependencies": {
    "@stark/agent-host": "workspace:*",
    "@stark/contracts": "workspace:*",
    "@stark/core": "workspace:*",
    "@stark/engineering": "workspace:*",
    "@stark/mcp-server": "workspace:*",
    "@stark/storage": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "fflate": "^0.8.2",
    "mathjs": "^15.2.0",
    "node-pty": "^1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
